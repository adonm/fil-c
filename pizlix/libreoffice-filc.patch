+#ifdef __FILC__
+
+// In Fil-C, the assembly privateSnippetExecutor and JIT code snippets are replaced
+// by a closure-based mechanism using zcall/zargs/zreturn primitives.
+//
+// The zargs() buffer contains all arguments laid out as a struct: each argument
+// is at max(8, alignment) offset and takes its normalized alloc size.  For the
+// UNO bridge every argument (hidden-return ptr, this, simple values, complex
+// ptrs) occupies exactly 8 bytes, so we simply walk the buffer in 8-byte steps.
+
+// Fil-C version of cpp2uno_call: takes a single argp pointer into the zargs
+// buffer instead of separate gpreg/fpreg/ovrflw arrays.
+static int cpp2uno_call_filc(
+    bridges::cpp_uno::shared::CppInterfaceProxy * pThis,
+    const typelib_TypeDescription * pMemberTypeDescr,
+    typelib_TypeDescriptionReference * pReturnTypeRef,
+    sal_Int32 nParams, typelib_MethodParameter * pParams,
+    char * argp,
+    sal_uInt64 * pRegisterReturn )
+{
+    // return
+    typelib_TypeDescription * pReturnTypeDescr = nullptr;
+    if (pReturnTypeRef)
+        TYPELIB_DANGER_GET( &pReturnTypeDescr, pReturnTypeRef );
+    x86_64::ReturnKind returnKind
+        = (pReturnTypeRef == nullptr || pReturnTypeRef->eTypeClass == typelib_TypeClass_VOID)
+        ? x86_64::ReturnKind::RegistersGeneral : x86_64::getReturnKind(pReturnTypeRef);
+
+    void * pUnoReturn = nullptr;
+    void * pCppReturn = nullptr;
+
+    if ( pReturnTypeDescr )
+    {
+        if ( returnKind == x86_64::ReturnKind::Memory )
+        {
+            pCppReturn = *reinterpret_cast<void **>(argp);
+            argp += 8;
+
+            pUnoReturn = ( bridges::cpp_uno::shared::relatesToInterfaceType( pReturnTypeDescr )
+                           ? alloca( pReturnTypeDescr->nSize )
+                           : pCppReturn );
+        }
+        else
+            pUnoReturn = pRegisterReturn;
+    }
+
+    // pop this
+    argp += 8;
+
+    // parameters
+    void ** pUnoArgs = static_cast<void **>(alloca( 4 * sizeof(void *) * nParams ));
+    void ** pCppArgs = pUnoArgs + nParams;
+    sal_Int32 * pTempIndices = reinterpret_cast<sal_Int32 *>(pUnoArgs + (2 * nParams));
+    typelib_TypeDescription ** ppTempParamTypeDescr = reinterpret_cast<typelib_TypeDescription **>(pUnoArgs + (3 * nParams));
+
+    sal_Int32 nTempIndices = 0;
+
+    for ( sal_Int32 nPos = 0; nPos < nParams; ++nPos )
+    {
+        const typelib_MethodParameter & rParam = pParams[nPos];
+
+        if ( !rParam.bOut && bridges::cpp_uno::shared::isSimpleType( rParam.pTypeRef ) )
+        {
+            // Simple type: value is in the zargs buffer at argp (8 bytes).
+            pCppArgs[nPos] = pUnoArgs[nPos] = argp;
+            argp += 8;
+        }
+        else // ref / complex
+        {
+            typelib_TypeDescription * pParamTypeDescr = nullptr;
+            TYPELIB_DANGER_GET( &pParamTypeDescr, rParam.pTypeRef );
+
+            void *pCppStack = *reinterpret_cast<void **>(argp);
+            argp += 8;
+            pCppArgs[nPos] = pCppStack;
+
+            if (! rParam.bIn) // pure out
+            {
+                pUnoArgs[nPos] = alloca( pParamTypeDescr->nSize );
+                pTempIndices[nTempIndices] = nPos;
+                ppTempParamTypeDescr[nTempIndices++] = pParamTypeDescr;
+            }
+            else if ( bridges::cpp_uno::shared::relatesToInterfaceType( pParamTypeDescr ) )
+            {
+                pUnoArgs[nPos] = alloca( pParamTypeDescr->nSize );
+                uno_copyAndConvertData( pUnoArgs[nPos],
+                                        pCppStack, pParamTypeDescr,
+                                        pThis->getBridge()->getCpp2Uno() );
+                pTempIndices[nTempIndices] = nPos;
+                ppTempParamTypeDescr[nTempIndices++] = pParamTypeDescr;
+            }
+            else
+            {
+                pUnoArgs[nPos] = pCppStack;
+                TYPELIB_DANGER_RELEASE( pParamTypeDescr );
+            }
+        }
+    }
+
+    // ExceptionHolder
+    uno_Any aUnoExc;
+    uno_Any * pUnoExc = &aUnoExc;
+
+    (*pThis->getUnoI()->pDispatcher)( pThis->getUnoI(), pMemberTypeDescr, pUnoReturn, pUnoArgs, &pUnoExc );
+
+    if ( pUnoExc )
+    {
+        for ( ; nTempIndices--; )
+        {
+            sal_Int32 nIndex = pTempIndices[nTempIndices];
+            if (pParams[nIndex].bIn)
+                uno_destructData( pUnoArgs[nIndex], ppTempParamTypeDescr[nTempIndices], nullptr );
+            TYPELIB_DANGER_RELEASE( ppTempParamTypeDescr[nTempIndices] );
+        }
+        if (pReturnTypeDescr)
+            TYPELIB_DANGER_RELEASE( pReturnTypeDescr );
+
+        CPPU_CURRENT_NAMESPACE::raiseException( &aUnoExc, pThis->getBridge()->getUno2Cpp() );
+        return 0;
+    }
+    else
+    {
+        for ( ; nTempIndices--; )
+        {
+            sal_Int32 nIndex = pTempIndices[nTempIndices];
+            typelib_TypeDescription * pParamTypeDescr = ppTempParamTypeDescr[nTempIndices];
+
+            if ( pParams[nIndex].bOut )
+            {
+                uno_destructData( pCppArgs[nIndex], pParamTypeDescr, cpp_release );
+                uno_copyAndConvertData( pCppArgs[nIndex], pUnoArgs[nIndex], pParamTypeDescr,
+                                        pThis->getBridge()->getUno2Cpp() );
+            }
+            uno_destructData( pUnoArgs[nIndex], pParamTypeDescr, nullptr );
+            TYPELIB_DANGER_RELEASE( pParamTypeDescr );
+        }
+        if ( pCppReturn )
+        {
+            if ( pUnoReturn != pCppReturn )
+            {
+                uno_copyAndConvertData( pCppReturn, pUnoReturn, pReturnTypeDescr,
+                                        pThis->getBridge()->getUno2Cpp() );
+                uno_destructData( pUnoReturn, pReturnTypeDescr, nullptr );
+            }
+            *reinterpret_cast<void **>(pRegisterReturn) = pCppReturn;
+        }
+        if ( pReturnTypeDescr )
+            TYPELIB_DANGER_RELEASE( pReturnTypeDescr );
+        switch (returnKind) {
+        case x86_64::ReturnKind::RegistersFpInt:
+            return 0;
+        case x86_64::ReturnKind::RegistersIntFp:
+            return 1;
+        default:
+            return -1;
+        }
+    }
+}
+
+// Fil-C version of cpp_vtable_call: takes argp into the zargs buffer.
+static int cpp_vtable_call_filc(
+    sal_Int32 nFunctionIndex, sal_Int32 nVtableOffset,
+    char * argp,
+    sal_uInt64 * pRegisterReturn )
+{
+    void * pThis;
+    if ( nFunctionIndex & 0x80000000 )
+    {
+        nFunctionIndex &= 0x7fffffff;
+        pThis = *reinterpret_cast<void**>(argp + 8); // second slot (after hidden return)
+    }
+    else
+    {
+        pThis = *reinterpret_cast<void**>(argp);
+    }
+    pThis = static_cast<char *>( pThis ) - nVtableOffset;
+
+    bridges::cpp_uno::shared::CppInterfaceProxy * pCppI =
+        bridges::cpp_uno::shared::CppInterfaceProxy::castInterfaceToProxy( pThis );
+
+    typelib_InterfaceTypeDescription * pTypeDescr = pCppI->getTypeDescr();
+
+    if ( nFunctionIndex >= pTypeDescr->nMapFunctionIndexToMemberIndex )
+    {
+        SAL_WARN(
+            "bridges",
+            "illegal " << OUString::unacquired(&pTypeDescr->aBase.pTypeName)
+                << " vtable index " << nFunctionIndex << "/"
+                << pTypeDescr->nMapFunctionIndexToMemberIndex);
+        throw RuntimeException(
+            ("illegal " + OUString::unacquired(&pTypeDescr->aBase.pTypeName)
+             + " vtable index " + OUString::number(nFunctionIndex) + "/"
+             + OUString::number(pTypeDescr->nMapFunctionIndexToMemberIndex)),
+            reinterpret_cast<XInterface *>( pCppI ) );
+    }
+
+    sal_Int32 nMemberPos = pTypeDescr->pMapFunctionIndexToMemberIndex[nFunctionIndex];
+    assert(nMemberPos < pTypeDescr->nAllMembers);
+
+    TypeDescription aMemberDescr( pTypeDescr->ppAllMembers[nMemberPos] );
+
+    int eRet;
+    switch ( aMemberDescr.get()->eTypeClass )
+    {
+        case typelib_TypeClass_INTERFACE_ATTRIBUTE:
+        {
+            typelib_TypeDescriptionReference *pAttrTypeRef =
+                reinterpret_cast<typelib_InterfaceAttributeTypeDescription *>( aMemberDescr.get() )->pAttributeTypeRef;
+
+            if ( pTypeDescr->pMapMemberIndexToFunctionIndex[nMemberPos] == nFunctionIndex )
+            {
+                eRet = cpp2uno_call_filc( pCppI, aMemberDescr.get(), pAttrTypeRef,
+                        0, nullptr, argp, pRegisterReturn );
+            }
+            else
+            {
+                typelib_MethodParameter aParam;
+                aParam.pTypeRef = pAttrTypeRef;
+                aParam.bIn      = true;
+                aParam.bOut     = false;
+
+                eRet = cpp2uno_call_filc( pCppI, aMemberDescr.get(),
+                        nullptr, 1, &aParam, argp, pRegisterReturn );
+            }
+            break;
+        }
+        case typelib_TypeClass_INTERFACE_METHOD:
+        {
+            switch ( nFunctionIndex )
+            {
+                case 1: // acquire()
+                    pCppI->acquireProxy();
+                    eRet = 0;
+                    break;
+                case 2: // release()
+                    pCppI->releaseProxy();
+                    eRet = 0;
+                    break;
+                case 0: // queryInterface() opt
+                {
+                    // In the zargs buffer: [retAny*], this, Type*
+                    void ** slots = reinterpret_cast<void **>(argp);
+                    typelib_TypeDescription * pTD = nullptr;
+                    TYPELIB_DANGER_GET( &pTD, static_cast<Type *>( slots[2] )->getTypeLibType() );
+                    if ( pTD )
+                    {
+                        XInterface * pInterface = nullptr;
+                        (*pCppI->getBridge()->getCppEnv()->getRegisteredInterface)
+                            ( pCppI->getBridge()->getCppEnv(),
+                              reinterpret_cast<void **>(&pInterface),
+                              pCppI->getOid().pData,
+                              reinterpret_cast<typelib_InterfaceTypeDescription *>( pTD ) );
+
+                        if ( pInterface )
+                        {
+                            ::uno_any_construct( static_cast<uno_Any *>( slots[0] ),
+                                                 &pInterface, pTD, cpp_acquire );
+                            pInterface->release();
+                            TYPELIB_DANGER_RELEASE( pTD );
+                            reinterpret_cast<void **>( pRegisterReturn )[0] = slots[0];
+                            eRet = 0;
+                            break;
+                        }
+                        TYPELIB_DANGER_RELEASE( pTD );
+                    }
+                    [[fallthrough]];
+                }
+                default:
+                {
+                    typelib_InterfaceMethodTypeDescription *pMethodTD =
+                        reinterpret_cast<typelib_InterfaceMethodTypeDescription *>( aMemberDescr.get() );
+
+                    eRet = cpp2uno_call_filc( pCppI, aMemberDescr.get(),
+                                         pMethodTD->pReturnTypeRef,
+                                         pMethodTD->nParams,
+                                         pMethodTD->pParams,
+                                         argp, pRegisterReturn );
+                }
+            }
+            break;
+        }
+        default:
+        {
+            throw RuntimeException(u"no member description found!"_ustr,
+                                    reinterpret_cast<XInterface *>( pCppI ) );
+        }
+    }
+
+    return eRet;
+}
+
+// Closure data carried by each vtable slot closure.
+struct SnippetData {
+    sal_Int32 nFunctionIndex;
+    sal_Int32 nVtableOffset;
+};
+
+// Fil-C replacement for the assembly privateSnippetExecutor.
+// This function is called as a Fil-C closure (via zclosure_new).  It retrieves
+// the function index / vtable offset from zcallee_closure_data(), the actual
+// arguments from zargs(), dispatches through cpp_vtable_call_filc, and returns
+// the result via zreturn().
+static void privateSnippetExecutorFilc( void )
+{
+    SnippetData * data = static_cast<SnippetData *>( zcallee_closure_data() );
+    char * argp = static_cast<char *>( zargs() );
+
+    sal_uInt64 pRegisterReturn[2] = { 0, 0 };
+
+    int eRet = cpp_vtable_call_filc( data->nFunctionIndex, data->nVtableOffset,
+                                     argp, pRegisterReturn );
+
+    // Determine whether we have a register return value to pass back.
+    // For void and hidden-pointer (Memory) returns, zreturn is not called.
+    // For all register returns, we pass the 16-byte pRegisterReturn buffer.
+    bool bHasReturn = false;
+    {
+        sal_Int32 nFunctionIndex = data->nFunctionIndex;
+        bool bHasHiddenParam = (nFunctionIndex & 0x80000000) != 0;
+        nFunctionIndex &= 0x7fffffff;
+
+        void * pThis;
+        if ( bHasHiddenParam )
+            pThis = *reinterpret_cast<void**>(argp + 8);
+        else
+            pThis = *reinterpret_cast<void**>(argp);
+        pThis = static_cast<char *>( pThis ) - data->nVtableOffset;
+
+        bridges::cpp_uno::shared::CppInterfaceProxy * pCppI =
+            bridges::cpp_uno::shared::CppInterfaceProxy::castInterfaceToProxy( pThis );
+        typelib_InterfaceTypeDescription * pTypeDescr = pCppI->getTypeDescr();
+
+        if ( nFunctionIndex < pTypeDescr->nMapFunctionIndexToMemberIndex )
+        {
+            sal_Int32 nMemberPos = pTypeDescr->pMapFunctionIndexToMemberIndex[nFunctionIndex];
+            TypeDescription aMemberDescr( pTypeDescr->ppAllMembers[nMemberPos] );
+            typelib_TypeDescriptionReference * pReturnTypeRef = nullptr;
+            if ( aMemberDescr.get()->eTypeClass == typelib_TypeClass_INTERFACE_ATTRIBUTE )
+            {
+                pReturnTypeRef =
+                    reinterpret_cast<typelib_InterfaceAttributeTypeDescription *>(
+                        aMemberDescr.get() )->pAttributeTypeRef;
+                // SET method has void return
+                if ( pTypeDescr->pMapMemberIndexToFunctionIndex[nMemberPos] != nFunctionIndex )
+                    pReturnTypeRef = nullptr;
+            }
+            else if ( aMemberDescr.get()->eTypeClass == typelib_TypeClass_INTERFACE_METHOD )
+            {
+                if ( nFunctionIndex >= 3 ) // not acquire/release/queryInterface
+                    pReturnTypeRef =
+                        reinterpret_cast<typelib_InterfaceMethodTypeDescription *>(
+                            aMemberDescr.get() )->pReturnTypeRef;
+            }
+
+            if ( pReturnTypeRef
+                 && pReturnTypeRef->eTypeClass != typelib_TypeClass_VOID
+                 && !x86_64::return_in_hidden_param( pReturnTypeRef ) )
+            {
+                bHasReturn = true;
+            }
+            else if ( nFunctionIndex == 0 )
+            {
+                // queryInterface always returns a pointer (in registers)
+                bHasReturn = true;
+            }
+        }
+    }
+
+    if ( bHasReturn )
+        zreturn( pRegisterReturn );
+    (void)eRet;
+}
